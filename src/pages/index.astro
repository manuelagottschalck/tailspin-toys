---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = [...new Map(
  games.flatMap((game) => game.category ? [[game.category.id, game.category.name] as const] : []),
).entries()]
  .map(([id, name]) => ({ id, name }))
  .sort((a, b) => a.name.localeCompare(b.name));
const publishers = [...new Map(
  games.flatMap((game) => game.publisher ? [[game.publisher.id, game.publisher.name] as const] : []),
).entries()]
  .map(([id, name]) => ({ id, name }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form id="game-filters" class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6" aria-label="Filter games" data-testid="game-filters">
            <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
              <fieldset>
                <legend class="mb-3 text-sm font-medium text-slate-200">Filter by category</legend>
                <div class="flex flex-wrap gap-3">
                  {categories.map((category) => (
                    <label class="inline-flex items-center gap-2 rounded-lg border border-slate-700 px-3 py-2 text-sm text-slate-200">
                      <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        class="rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                        data-testid={`category-filter-${category.id}`}
                      />
                      <span>{category.name}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <div class="flex flex-col gap-2">
                <label for="publisher-filter" class="text-sm font-medium text-slate-200">Filter by publisher</label>
                <select
                  id="publisher-filter"
                  name="publisher"
                  class="min-h-10 rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                  data-testid="publisher-filter"
                >
                  <option value="">All publishers</option>
                  {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
                </select>
              </div>

              <button
                type="reset"
                class="min-h-10 rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="clear-filters"
              >
                Clear filters
              </button>
            </div>
          </form>

          <p id="filter-result-count" class="mb-4 text-sm text-slate-300" role="status" aria-live="polite" aria-atomic="true">
            Showing {games.length} of {games.length} games
          </p>
          <p id="no-filter-results" class="mb-6 rounded-xl border border-slate-700 bg-slate-800 p-6 text-slate-300" hidden>
            No games match the selected filters.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('#game-filters');
  const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const resultCount = document.querySelector<HTMLElement>('#filter-result-count');
  const noResults = document.querySelector<HTMLElement>('#no-filter-results');

  if (filterForm && resultCount && noResults) {
    const categoryInputs = Array.from(filterForm.querySelectorAll<HTMLInputElement>('input[name="category"]'));
    const publisherSelect = filterForm.querySelector<HTMLSelectElement>('select[name="publisher"]');

    /**
     * Applies the current category and publisher selections to the game cards.
     */
    const updateResults = (): void => {
      const selectedCategories = categoryInputs
        .filter((input) => input.checked)
        .map((input) => input.value);
      const selectedPublisher = publisherSelect?.value ?? '';
      let visibleCount = 0;

      for (const card of gameCards) {
        const categoryMatches = selectedCategories.length === 0
          || selectedCategories.includes(card.dataset.gameCategoryId ?? '');
        const publisherMatches = selectedPublisher === ''
          || card.dataset.gamePublisherId === selectedPublisher;
        const matches = categoryMatches && publisherMatches;
        card.hidden = !matches;
        if (matches) visibleCount++;
      }

      resultCount.textContent = `Showing ${visibleCount} of ${gameCards.length} games`;
      noResults.hidden = visibleCount > 0;
    };

    filterForm.addEventListener('change', updateResults);
    filterForm.addEventListener('reset', () => requestAnimationFrame(updateResults));
  }
</script>
